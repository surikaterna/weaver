{
  "name": "weaver",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/weaver.git"
  },
  "homepage": "https://github.com/surikaterna/weaver#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/weaver/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "biome check --write .",
    "test": "turbo test",
    "docs": "typedoc",
    "docs:build": "turbo build && typedoc && cp -r apps/demo/dist/* docs-dist/",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "playground": "turbo run start --filter=@weaver-conf/playground"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "turbo": "2.9.6",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.58.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@scompr/types": "0.2.0"
  }
}
