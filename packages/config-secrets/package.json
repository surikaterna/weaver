{
  "name": "@weaver-conf/config-secrets",
  "version": "0.1.2",
  "description": "Server-side secret resolution for Weaver configuration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/weaver.git",
    "directory": "packages/config-secrets"
  },
  "homepage": "https://github.com/surikaterna/weaver/tree/main/packages/config-secrets#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/weaver/issues"
  },
  "keywords": [
    "weaver",
    "configuration",
    "config",
    "secrets",
    "keyvault"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/keyvault-secrets": "4.11.1",
    "@weaver-conf/config-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "^5.8.3"
  }
}
