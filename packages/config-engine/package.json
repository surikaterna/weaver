{
  "name": "@weaver-conf/config-engine",
  "version": "0.1.2",
  "description": "Deep merge, layer resolution, key inspection, scope chains, and schema registry for Weaver configuration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/weaver.git",
    "directory": "packages/config-engine"
  },
  "homepage": "https://github.com/surikaterna/weaver/tree/main/packages/config-engine#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/weaver/issues"
  },
  "keywords": [
    "weaver",
    "configuration",
    "config",
    "layered",
    "engine",
    "merge",
    "resolution",
    "layers"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --import tsx --test --test-concurrency=1 test/*.node.mjs",
    "lint": "biome check ."
  },
  "dependencies": {
    "@weaver-conf/config-types": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
