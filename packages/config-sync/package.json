{
  "name": "@weaver-conf/config-sync",
  "version": "0.1.3",
  "description": "Offline-first sync orchestrator with snapshot caching, mutation queuing, and conflict resolution for Weaver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/weaver.git",
    "directory": "packages/config-sync"
  },
  "homepage": "https://github.com/surikaterna/weaver/tree/main/packages/config-sync#readme",
  "bugs": {
    "url": "https://github.com/surikaterna/weaver/issues"
  },
  "keywords": [
    "weaver",
    "configuration",
    "config",
    "layered",
    "sync",
    "offline",
    "conflict-resolution"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "@weaver-conf/config-types": "workspace:*",
    "@weaver-conf/config-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
