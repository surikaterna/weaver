    "mongodb": "^6.12.0",
    "simple-git": "^3.27.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "simple-git": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "mongodb": "^6.12.0",
    "simple-git": "^3.27.0",
    "typescript": "^5.8.3"
  }
