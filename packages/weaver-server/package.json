{
  "name": "@weaver-conf/weaver-server",
  "version": "0.1.4",
  "description": "Central configuration server for Weaver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/weaver.git",
    "directory": "packages/weaver-server"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "weaver-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:pipeline": "node --import tsx --test test/validated-pipeline.node.mjs",
    "test:vitest": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:schemas": "node --import tsx --test --test-concurrency=1 test/schema-foundations/*.node.mjs",
    "test:node": "node --import tsx --test --test-concurrency=1 test/*.node.mjs test/schema-foundations/*.node.mjs",
    "test:bootstrap": "node --import tsx --test --test-concurrency=1 test/bootstrap-*.node.mjs",
    "lint": "biome check ."
  },
  "dependencies": {
    "@weaver-conf/config-types": "workspace:*",
    "@weaver-conf/config-engine": "workspace:*",
    "@weaver-conf/config-runtime": "workspace:*",
    "@weaver-conf/config-auth": "workspace:*",
    "@weaver-conf/storage-providers": "workspace:*",
    "@weaver-conf/transport-scomp": "workspace:*",
    "zod": "^4.0.0",
    "@scompr/core": "^0.2.0",
    "express": "^5.1.0"
  },
  "peerDependencies": {
    "mongodb": "^6.12.0",
    "simple-git": "^3.27.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "simple-git": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "mongodb": "^6.12.0",
    "simple-git": "^3.27.0",
    "typescript": "^5.8.3",
    "@types/express": "^5.0.3"
  }
}
