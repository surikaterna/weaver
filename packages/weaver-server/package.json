{
  "name": "@weaver-conf/weaver-server",
  "version": "0.1.4",
  "description": "Central configuration server for Weaver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/surikaterna/weaver.git",
    "directory": "packages/weaver-server"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "weaver-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-test-partition.mjs verify-default",
    "test:activation-recovery": "node test/run-test-partition.mjs activation-recovery",
    "test:compensation": "node test/run-test-partition.mjs compensation",
    "test:core-catalog": "node test/run-test-partition.mjs core-catalog",
    "test:core-lifecycle": "node test/run-test-partition.mjs core-lifecycle",
    "test:core-pipeline": "node test/run-test-partition.mjs core-pipeline",
    "test:final-b": "node test/run-test-partition.mjs final-b",
    "test:node-bootstrap": "node test/run-test-partition.mjs node-bootstrap",
    "test:node-cli": "node test/run-test-partition.mjs node-cli",
    "test:node-schema": "node test/run-test-partition.mjs node-schema",
    "test:node-u9-fs": "node test/run-test-partition.mjs node-u9-fs",
    "test:node-u9-process": "node test/run-test-partition.mjs node-u9-process",
    "test:node-upgrade-crash": "node test/run-test-partition.mjs node-upgrade-crash",
    "test:node-upgrade-terminal": "node test/run-test-partition.mjs node-upgrade-terminal",
    "test:stale-activation": "node test/run-test-partition.mjs stale-activation",
    "test:stale-journal": "node test/run-test-partition.mjs stale-journal",
    "test:stale-plan": "node test/run-test-partition.mjs stale-plan",
    "test:upgrade-final-a": "node test/run-test-partition.mjs upgrade-final-a",
    "test:upgrade-main": "node test/run-test-partition.mjs upgrade-main",
    "test:upgrade-policy": "node test/run-test-partition.mjs upgrade-policy",
    "test:vitest-core": "node test/run-test-partition.mjs vitest-core",
    "test:vitest-transport": "node test/run-test-partition.mjs vitest-transport",
    "test:manifest": "node test/run-test-partition.mjs verify-all",
    "test:live-mongo": "node test/run-test-partition.mjs verify-live",
    "test:live-mongo:preflight": "node test/live-mongo-preflight.mjs",
    "test:live-mongo-conflicts": "node test/run-test-partition.mjs live-mongo-conflicts",
    "test:live-mongo-integration": "node test/run-test-partition.mjs live-mongo-integration",
    "test:live-mongo-terminal": "node test/run-test-partition.mjs live-mongo-terminal",
    "lint": "biome check ."
  },
  "dependencies": {
    "@weaver-conf/config-types": "workspace:*",
    "@weaver-conf/config-engine": "workspace:*",
    "@weaver-conf/config-runtime": "workspace:*",
    "@weaver-conf/config-auth": "workspace:*",
    "@weaver-conf/storage-providers": "workspace:*",
    "@weaver-conf/transport-scomp": "workspace:*",
    "zod": "^4.0.0",
    "@scompr/core": "^0.2.0",
    "express": "^5.1.0"
  },
  "peerDependencies": {
    "mongodb": "^6.12.0",
    "simple-git": "^3.27.0"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    },
    "simple-git": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "mongodb": "^6.12.0",
    "simple-git": "^3.27.0",
    "typescript": "^5.8.3",
    "@types/express": "^5.0.3"
  }
}
